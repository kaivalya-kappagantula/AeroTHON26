<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>obstacle_avoidance</name>
  <version>0.0.0</version>
  <description>Forward-facing OAK-D depth: ArduPilot proximity (sector builder), sensor health (coverage guard) and corridor perception.</description>
  <maintainer email="jaya9899@todo.todo">jaya9899</maintainer>
  <license>TODO: License declaration</license>

  <depend>rclpy</depend>
  <depend>mission_common</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>mavros_msgs</depend>
  <depend>std_srvs</depend>
  <depend>tf2_ros</depend>
  <depend>python3-numpy</depend>
  <depend>python3-opencv</depend>

  <!-- runtime tools used by optional nodes -->
  <exec_depend>mavros</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
