<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>path_planner</name>
  <version>0.0.0</version>
  <description>Flies the mission legs (corridors, lawnmower search) as GUIDED waypoints via MAVROS.</description>
  <maintainer email="jaya9899@todo.todo">jaya9899</maintainer>
  <license>TODO: License declaration</license>

  <depend>rclpy</depend>
  <depend>mission_common</depend>
  <depend>rcl_interfaces</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-shapely</exec_depend>

  <test_depend>python3-pytest</test_depend>
  <!-- test_entry_corridor.py: the real corridor fit on ray-cast depth -->
  <test_depend>obstacle_avoidance</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
